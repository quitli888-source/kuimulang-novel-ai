# ============================================================
#  番茄小说AI创作系统 V5 配置文件
#  请把这里的值改成你自己的，保存后重命名为 .env
# ============================================================

# 【必须填写】MiniMax API Key（去 https://www.minimaxi.com/user-center/basic-information/interface-key 获取）
MINIMAX_API_KEY=your_api_key_here

# 【可选】API 地址（默认使用MiniMax官方地址，一般不需要改）
MINIMAX_BASE_URL=https://api.minimax.chat

# 【可选】模型名称（一般不需要改）
MINIMAX_MODEL=abab6.5s-chat

# 【可选】JSON任务专用模型（一般不需要改）
MINIMAX_JSON_MODEL=abab6.5s-chat
