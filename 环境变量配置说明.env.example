# ============================================================
#  番茄小说AI创作系统 V7 配置文件
#  请把这里的值改成你自己的，保存后重命名为 .env
# ============================================================
#
# 【当前激活】Step-3.7-Flash（必须填写，连接到 https://api.stepfun.com/step_plan/v1）
# 用户原话：「项目中要用到step的地方都走这个url https://api.stepfun.com/step_plan/v1」
#
STEP_API_KEY=your_step_api_key_here
STEP_BASE_URL=https://api.stepfun.com/step_plan/v1
STEP_MODEL=step-3.7-flash
STEP_JSON_MODEL=step-3.7-flash

# ============================================================
#  【可选】其他预设供应商（一般不需要改）
#  当前默认激活的供应商是 step，如需切换可在前端配置面板选择
# ============================================================

# MiniMax API Key（去 https://www.minimaxi.com/user-center/basic-information/interface-key 获取）
# MINIMAX_API_KEY=your_api_key_here
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-Text-01
# MINIMAX_JSON_MODEL=abab6.5s-chat

# DeepSeek API Key
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_JSON_MODEL=deepseek-chat

# OpenAI API Key（需要海外网络）
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_JSON_MODEL=gpt-4o-mini

# SiliconFlow（硅基流动，国内可用）
# SILICONFLOW_API_KEY=your_siliconflow_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
# SILICONFLOW_JSON_MODEL=Qwen/Qwen2.5-72B-Instruct