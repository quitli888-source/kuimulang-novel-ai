# ============================================================
#  番茄小说AI创作系统 V7 - 配置文件
#
#  使用步骤：
#  1. 复制本文件，重命名为 .env（注意前面有个点！）
#  2. 填入你的 API Key（只需填一个你使用的供应商）
#  3. 保存文件
#  4. 双击"安装脚本.bat"完成安装
#  5. 双击"启动图形界面.bat"开始使用
#
#  支持的供应商（只需配置一个）：
#  - Step-3.7-Flash（推荐，长上下文创作，base_url=https://api.stepfun.com/step_plan/v1）
#  - MiniMax（api.minimax.chat/v1）
#  - MiniMax-M3（api.minimax.cn/v1，新增）
#  - DeepSeek（性价比高）
#  - OpenAI（GPT系列，需要海外网络）
#  - SiliconFlow（硅基流动，国内可用）
# ============================================================

# Step-3.7-Flash（推荐，长上下文创作）
STEP_API_KEY=your_step_api_key_here
# 可选：覆盖默认模型（默认 step-3.7-flash）
# STEP_MODEL=step-3.7-flash
# STEP_JSON_MODEL=step-3.7-flash
# STEP_BASE_URL=https://api.stepfun.com/step_plan/v1

# MiniMax API Key（https://api.minimax.chat/v1）
# MINIMAX_API_KEY=your_minimax_key_here
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-Text-01
# MINIMAX_JSON_MODEL=abab6.5s-chat

# MiniMax-M3 API Key（https://api.minimax.cn/v1，新增）
# MINIMAX_M3_API_KEY=your_minimax_m3_key_here
# MINIMAX_M3_BASE_URL=https://api.minimax.cn/v1
# MINIMAX_M3_MODEL=MiniMax-M3
# MINIMAX_M3_JSON_MODEL=abab6.5s-chat

# DeepSeek API Key
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_JSON_MODEL=deepseek-chat

# OpenAI API Key（需要海外网络）
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_JSON_MODEL=gpt-4o-mini

# SiliconFlow API Key（硅基流动，国内可用）
# SILICONFLOW_API_KEY=your_siliconflow_key_here
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
# SILICONFLOW_JSON_MODEL=Qwen/Qwen2.5-72B-Instruct